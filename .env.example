# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Hostinger VPS (copy these to the server .env and fill in real values)
# DEBUG=False
# SITE_DOMAIN=yourdomain.com
# VPS_IP=x.x.x.x
# ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,x.x.x.x
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# SECURE_SSL_REDIRECT=False
# CORS_ALLOW_ALL_ORIGINS=False

# Database Configuration
# SQLite (development) — leave DATABASE_URL unset
# DATABASE_ENGINE=django.db.backends.sqlite3

# PostgreSQL via URL (Render sets this automatically)
# DATABASE_URL=postgresql://user:password@localhost:5432/learning_hub
# DATABASE_SSL_REQUIRE=False

# Hostinger MariaDB / MySQL
# DATABASE_URL=mysql://studynation:password@127.0.0.1:3306/studynation
# DATABASE_ENGINE=django.db.backends.mysql
# DATABASE_NAME=studynation
# DATABASE_USER=studynation
# DATABASE_PASSWORD=change-me
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=3306

# Or discrete Postgres vars (Docker Compose)
# DATABASE_ENGINE=django.db.backends.postgresql
# DATABASE_NAME=learning_hub
# DATABASE_USER=postgres
# DATABASE_PASSWORD=your-password
# DATABASE_HOST=localhost
# DATABASE_PORT=5432

# Security / CSRF (production HTTPS origins, comma-separated)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# CORS Settings
CORS_ALLOW_ALL_ORIGINS=True

# Logging
LOG_LEVEL=INFO

# Email Configuration (optional)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-password

# ========== SUPERUSER (Only for first deploy) ==========
CREATE_SUPERUSER=True
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@gmail.com
DJANGO_SUPERUSER_PASSWORD=Password@123